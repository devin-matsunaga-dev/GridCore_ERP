<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GridCore.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- MassTransit 8.x only — 9.x is commercially licensed. See Directory.Packages.props. -->
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <!-- Object store: MinIO behind Contracts' IDocumentStore. Apache-2.0 — see Directory.Packages.props. -->
    <PackageReference Include="Minio" />
    <!-- Design-time only: `dotnet ef migrations add` against this library. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Contracts/GridCore.Contracts.csproj" />
  </ItemGroup>

  <!-- The fast tier exercises the scheduler's failure isolation, which is not public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="GridCore.Platform.UnitTests" />
  </ItemGroup>

</Project>
